# ==============================================================
# پُست‌یار — نمونه فایل محیطی (Environment Example)
# --------------------------------------------------------------
# دستورالعمل: این فایل را به app/.env کپی کنید و مقادیر را پر کنید:
#     cp .env.example app/.env && chmod 600 app/.env
# هیچ مقدار واقعی در این فایل قرار نگیرد (فقط placeholder).
# هرگز app/.env را commit نکنید (در .gitignore است).
# --------------------------------------------------------------
# قاعده: در production این متغیرها باید در محیط فرآیند Passenger هم
# تنظیم شوند (cPanel → Setup Node.js App → Environment variables)
# چون app/src/config/env.ts فقط process.env را می‌خواند.
# ==============================================================

# --- هسته (Core) -------------------------------------------------------------
# محیط اجرا: development | test | production
NODE_ENV=production
# آدرس عمومی رابط کاربری (SPA) — برای CORS و ساخت لینک‌های رسانه
APP_URL=https://example.com
# آدرس عمومی API
API_URL=https://example.com
# پورت داخلی API (Passenger/CloudLinux این مقدار را مدیریت می‌کند؛ پیش‌فرض 3001)
PORT=3001

# --- زیرساخت (Infrastructure) ------------------------------------------------
# اتصال MySQL/MariaDB — اجباری در همه محیط‌ها
DATABASE_URL=mysql://user:password@127.0.0.1:3306/dbname
# اتصال Redis (سرویس ارائه‌شده توسط هاست — هرگز Redis را خودتان نصب نکنید) — اجباری در production
REDIS_URL=redis://127.0.0.1:6379

# --- امنیت (Secrets) — اجباری در production -----------------------------------
# حداقل ۳۲ کاراکتر تصادفی (openssl rand -hex 32)
SESSION_SECRET=__GENERATE_WITH_openssl_rand_hex_32__
# حداقل ۳۲ کاراکتر تصادفی — مقدار متفاوت از SESSION_SECRET
CSRF_SECRET=__GENERATE_WITH_openssl_rand_hex_32__
# دقیقاً ۳۲ کاراکتر یا ۶۴ کاراکتر hex — کلید AES-256-GCM برای رمزنگاری توکن‌ها
# هشدار: با تغییر این کلید، اسرار ذخیره‌شده قبلی قابل بازیابی نیستند
ENCRYPTION_KEY=__EXACTLY_32_OR_64_HEX_CHARS__

# --- ایمیل (اختیاری) ----------------------------------------------------------
MAIL_HOST=
MAIL_PORT=
MAIL_USER=
# نام طبق master prompt §91؛ اپ از MAIL_PASS می‌خواند (هر دو مجاز)
MAIL_PASSWORD=
MAIL_PASS=
MAIL_FROM=

# --- پیامک (اختیاری) ----------------------------------------------------------
SMS_PROVIDER=
SMS_API_KEY=
SMS_SENDER=

# --- توکن‌های سروری پیش‌فرض ارائه‌دهنده‌ها (اختیاری؛ fallback وقتی مستأجر توکن ندارد)
TELEGRAM_BOT_TOKEN=
BALE_BOT_TOKEN=
RUBIKA_BOT_TOKEN=

# --- کلیدهای هوش مصنوعی (اختیاری؛ fallback سطح سرور) --------------------------
OPENAI_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
# نام طبق master prompt §91؛ اپ از CLAUDE_API_KEY می‌خواند (هر دو مجاز)
ANTHROPIC_API_KEY=
CLAUDE_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=

# --- درگاه پرداخت (اختیاری) ---------------------------------------------------
# ZARINPAL | IDPAY | ZIBAL | MOCK
PAYMENT_PROVIDER=
PAYMENT_MERCHANT_ID=
PAYMENT_API_KEY=

# --- عملیات (Ops) -------------------------------------------------------------
# fatal | error | warn | info | debug | trace
LOG_LEVEL=info
# مسیر ذخیره‌سازی فایل‌های رسانه (نسبت به ریشه‌ی app؛ پیش‌فرض ../storage)
STORAGE_DIR=../storage
# توکن اختیاری برای محافظت از endpoint اجرای seed
SEED_TOKEN=
